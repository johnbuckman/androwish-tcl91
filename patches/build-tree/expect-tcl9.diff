diff --git a/jni/expect/exp_chan.c b/jni/expect/exp_chan.c
index 70873812..ea967863 100644
--- a/jni/expect/exp_chan.c
+++ b/jni/expect/exp_chan.c
@@ -56,6 +56,41 @@ static int		ExpGetHandleProc _ANSI_ARGS_((ClientData instanceData,
  * This structure describes the channel type structure for Expect-based IO:
  */
 
+#if TCL_MAJOR_VERSION >= 9
+/*
+ * Tcl 9 only takes TCL_CHANNEL_VERSION_5 with a close2Proc.  Without this
+ * branch, Tcl 9 (which has no TCL_CHANNEL_VERSION_2) got the Tcl 7 layout
+ * below, with ExpBlockModeProc in the version slot, and panicked.
+ */
+static int
+ExpClose2Proc(ClientData instanceData, Tcl_Interp *interp, int flags)
+{
+    if ((flags & (TCL_CLOSE_READ | TCL_CLOSE_WRITE)) != 0) {
+	return EINVAL;
+    }
+    return ExpCloseProc(instanceData, interp);
+}
+
+Tcl_ChannelType expChannelType = {
+    "exp",				/* Type name. */
+    TCL_CHANNEL_VERSION_5,
+    NULL,				/* Close proc (unused). */
+    ExpInputProc,			/* Input proc. */
+    (Tcl_DriverOutputProc *) ExpOutputProc,	/* Output proc. */
+    NULL,				/* Seek proc (unused). */
+    NULL,				/* Set option proc. */
+    NULL,				/* Get option proc. */
+    ExpWatchProc,			/* Initialize notifier. */
+    ExpGetHandleProc,			/* Get OS handles out of channel. */
+    ExpClose2Proc,			/* Close2 proc */
+    ExpBlockModeProc,			/* Set blocking/nonblocking mode.*/
+    NULL,				/* Flush proc. */
+    NULL,				/* Handler proc. */
+    NULL,				/* Wide seek proc. */
+    NULL,				/* Thread action proc. */
+    NULL,				/* Truncate proc. */
+};
+#else
 Tcl_ChannelType expChannelType = {
     "exp",				/* Type name. */
 #ifdef TCL_CHANNEL_VERSION_2
@@ -83,6 +118,7 @@ Tcl_ChannelType expChannelType = {
     NULL,				/* Close2 proc */
 #endif
 };
+#endif /* TCL_MAJOR_VERSION >= 9 */
 
